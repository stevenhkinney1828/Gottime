# Copy this file to .env for local scripts (backend/scripts/*.ts, local migration tooling).
# NEVER commit a real .env file. NEVER put any of these real values in the iOS app target
# except the two explicitly marked "safe to embed" below.
#
# GitHub Actions CI secrets (signing/App Store Connect) are configured in the GitHub repo's
# own Settings > Secrets UI, not here — see SETUP.md.

# --- Local Postgres (Phase 0+, no Supabase account needed) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gottime_dev

# --- Supabase project (Phase 2+, owner-supplied) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# safe to embed in the iOS app: SUPABASE_URL + SUPABASE_ANON_KEY are protected entirely by
# Row Level Security, not by secrecy.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Edge Function runtime only. Never in the iOS binary,
# never in a GitHub Actions log, never committed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Twilio (Phase 4+, owner-supplied) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_AUTH_TOKEN: master secret, only used by backend/scripts/twilio-setup.ts (one-time
# TwiML App + API Key provisioning) and for validating inbound Twilio webhook signatures.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# --- APNs VoIP push (Phase 5+, owner-supplied) ---
APNS_AUTH_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# APNS_TOPIC is the bundle ID + ".voip" suffix, e.g. com.example.gottime.voip
APNS_ENVIRONMENT=sandbox
# sandbox while side-loaded via Xcode/TestFlight-internal dev builds; production for
# App Store / TestFlight-distributed release builds.
